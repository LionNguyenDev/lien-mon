{
  "name": "nextjs-boilerplate",
  "version": "0.1.0",
  "private": true,
  "author": {
    "email": "luund206@gmail.com",
    "name": "Lưu Nguyễn Danh"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "format:check": "biome format . ",
    "format:fix": "biome format .  --write",
    "type-check": "tsc --noEmit",
    "postinstall": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "pnpm lint:fix",
      "pnpm format:fix"
    ]
  }
}
